# ---------------------------------------------------------------------------
# TokenMiner - environment template
# Copy to `.env` and fill in. `.env` is gitignored; never commit real secrets.
# ---------------------------------------------------------------------------

# --- PostgreSQL (docker-compose) ---
# These defaults match docker-compose.yml and appsettings.Development.json so a
# local `docker compose up -d` + `dotnet run` works with no further setup.
# Change the password for anything that is not your machine.
POSTGRES_USER=tokenminer
POSTGRES_PASSWORD=tokenminer
POSTGRES_DB=tokenminer
# Host port for the container. 5433 avoids clashing with a native local
# PostgreSQL that may already own 5432.
POSTGRES_PORT=5433

# --- API ---
ASPNETCORE_ENVIRONMENT=Development
# Connection string consumed by EF Core / Npgsql (double underscore = config nesting)
ConnectionStrings__Default=Host=localhost;Port=${POSTGRES_PORT};Database=${POSTGRES_DB};Username=${POSTGRES_USER};Password=${POSTGRES_PASSWORD}

# JWT signing key (use a long random value; rotate via `kid`)
Auth__Jwt__SigningKey=replace-with-a-32byte-plus-random-secret
Auth__Jwt__Issuer=tokenminer
Auth__Jwt__Audience=tokenminer-client

# Google desktop (native) OAuth client id - the `aud` we validate ID tokens against
Auth__Google__DesktopClientId=replace-with-google-desktop-client-id

# SMTP for email verification + OTP (leave host empty in dev to use the console sender)
Smtp__Host=
Smtp__Port=587
Smtp__UserName=
Smtp__Password=
Smtp__FromAddress=no-reply@tokenminer.local
Smtp__FromName=TokenMiner

# --- Stratum proxy ---
# Shared secret for signed machine-to-machine calls. Must match the API's
# Mining:ServiceSharedSecret (see appsettings.Development.json for the dev value).
MINING_SERVICE_SHARED_SECRET=dev-only-service-shared-secret-change-me
# Base URL the containerised proxy uses to reach the API running on the host.
TOKENMINER_API_BASE_URL=http://host.docker.internal:5210
